# --- LLM: direct OpenAI vs. Agent Manager's LLM gateway ---
# Direct mode (default below): set OPENAI_API_KEY, leave LLM_GATEWAY_BASE_URL unset.
# Gateway mode: set LLM_GATEWAY_BASE_URL + LLM_GATEWAY_API_KEY instead - see
# agent.py's _build_llm(). Auth to the gateway is sent as `API-Key: <value>`
# (not `Authorization: Bearer`).
OPENAI_API_KEY=REPLACE_ME
LLM_MODEL=gpt-4o-mini
# LLM_GATEWAY_BASE_URL=REPLACE_ME_LLM_GATEWAY_URL
# LLM_GATEWAY_API_KEY=REPLACE_ME

# --- MCP: direct (ungoverned) vs. Agent Manager's MCP gateway ---
# Direct mode (default below): set MCP_SERVER_URL, leave MCP_GATEWAY_URL unset.
MCP_SERVER_URL=http://localhost:8001/mcp

# Gateway mode, API Key (Module 02): set MCP_GATEWAY_URL + MCP_GATEWAY_API_KEY
# instead - the accounts-mcp server's URL as fronted by Agent Manager's MCP
# gateway, and the API key it's secured with (its default scheme). Sent as
# an `API-Key` header, same pattern as the LLM gateway. No per-agent
# identity yet - every agent using this key gets the same access.
# MCP_GATEWAY_URL=REPLACE_ME_FULL_MCP_GATEWAY_URL
# MCP_GATEWAY_API_KEY=REPLACE_ME

# Gateway mode, AgentID (Module 03, Part B): set MCP_GATEWAY_URL, leave
# MCP_GATEWAY_API_KEY unset, and set the AMP_AGENTID_* vars below instead.
# This agent then mints its own AgentID access token (client-credentials
# grant) and Agent Manager enforces tool-access policy per this agent's
# identity - see agent.py's _build_mcp_client() / _mint_agentid_token().
# This identity is expected to be PERMITTED for open_account/
# transfer_money/check_balance once that policy is configured.
# AMP_AGENTID_CLIENT_ID=REPLACE_ME_ACCOUNT_ASSISTANT_CLIENT_ID
# AMP_AGENTID_CLIENT_SECRET=REPLACE_ME_ACCOUNT_ASSISTANT_CLIENT_SECRET
# AMP_AGENTID_TOKEN_ENDPOINT=REPLACE_ME_TOKEN_ENDPOINT_URL
# AMP_AGENTID_SCOPES=REPLACE_ME_SCOPES

# --- Manual instrumentation (off by default) ---
# Agent Manager can auto-instrument a deployed agent with OTEL tracing
# (Module 04's "Enable auto instrumentation" toggle) - that's the default
# and needs nothing set here. Turn this on only if that auto-instrumentation
# is turned OFF for this agent, e.g. because auto-instrumentation doesn't
# correctly capture a denied/failed MCP tool call (it doesn't unwrap the
# ExceptionGroup langgraph/langchain-mcp-adapters raise tool failures in -
# see instrumentation.py). Running both at once duplicates traces.
# AMP_MANUAL_INSTRUMENTATION_ENABLED=true
# Same AMP_OTEL_ENDPOINT / AMP_AGENT_API_KEY Agent Manager injects for its
# own auto-instrumentation - required if the toggle above is set.
# AMP_OTEL_ENDPOINT=REPLACE_ME_OTEL_ENDPOINT
# AMP_AGENT_API_KEY=REPLACE_ME
# Whether tool call arguments/results are attached to spans (default true).
# Set to "false" to keep account numbers/balances out of trace data.
# AMP_TRACE_CONTENT=true

# Port for this agent's FastAPI /chat service is hardcoded in main.py (8000).
# Not configurable here. Both agents in this repo use 8000; run them as
# separate processes/containers (as Agent Manager deploys them), not
# side by side on one machine.
