# Asgardeo application config — copy this file to .env and fill in your own values.
# Create an app at https://console.asgardeo.io (Standard-Based Application, OIDC, SPA).
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<org-name>
VITE_ASGARDEO_CLIENT_ID=<client-id>
VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=http://localhost:5174
VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=http://localhost:5174

# Customer Support agent base URL (Stage 1-style direct agent, no MCP gateway).
VITE_AGENT_BASE_URL=http://localhost:8000
