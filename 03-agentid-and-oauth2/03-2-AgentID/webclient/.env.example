# Copy this file to .env and fill in your own values.
# Sets the default agent base URLs shown in the console — still editable
# live in the page, these just control what it starts with.

# Customer Support agent base URL.
VITE_CUSTOMER_SUPPORT_URL=http://localhost:8000

# Account Assistant agent base URL.
VITE_ACCOUNT_ASSISTANT_URL=http://localhost:8002

# Optional per-agent API keys sent as the x-api-key header on that agent's
# /chat requests. Leave unset if an agent doesn't require one.
VITE_CUSTOMER_SUPPORT_API_KEY=
VITE_ACCOUNT_ASSISTANT_API_KEY=

# Optional Asgardeo application config — copy this file to .env and fill in
# your own values. Create an app at https://console.asgardeo.io
# (Standard-Based Application, OIDC, SPA). Leave unset to run the console
# without sign-in (no Bearer token attached to /chat requests).
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<org-name>
VITE_ASGARDEO_CLIENT_ID=<client-id>
VITE_ASGARDEO_SIGN_IN_REDIRECT_URL=http://localhost:5173
VITE_ASGARDEO_SIGN_OUT_REDIRECT_URL=http://localhost:5173
