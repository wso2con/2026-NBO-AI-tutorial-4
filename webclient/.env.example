# Copy this file to .env and fill in your own values.
# Sets the default agent base URLs shown in the console — still editable
# live in the page, these just control what it starts with.

# Customer Support agent base URL.
VITE_CUSTOMER_SUPPORT_URL=http://localhost:8000

# Account Assistant agent base URL.
VITE_ACCOUNT_ASSISTANT_URL=http://localhost:8002
